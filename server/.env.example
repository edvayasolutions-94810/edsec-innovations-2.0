# Server Environment Variables Example

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edsec?retryWrites=true&w=majority

# Production Frontend URL for CORS Whitelisting
FRONTEND_URL=https://edsecinnovations.com

# Admin Email for Notifications
ADMIN_EMAIL=edsecinnovations@gmail.com

# Admin WhatsApp Phone Number
ADMIN_WHATSAPP=918660132700

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# SMTP / Email Service Configuration (Used for Brochure OTP and Enrollment notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here

# Optional WhatsApp Integration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional WhatsApp Integration (Meta Cloud API)
META_WA_ACCESS_TOKEN=your_meta_wa_access_token
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id

# 2Factor SMS Gateway Configuration (Brochure Download OTP)
TF_API=your_2factor_api_key_here
TF_TEMPLATE_NAME=RegistrationOTP
